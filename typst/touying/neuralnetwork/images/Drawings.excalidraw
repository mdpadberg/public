    },
    {
      "id": "vYmk2cT-iy2hMO7vUcl8J",
      "type": "text",
      "x": 5115.813078752822,
      "y": 1423.7947576411354,
      "width": 960.4000244140625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NBl4zNV_0fJPPt_bVEoxm",
      "index": "bFCl",
      "roundness": null,
      "seed": 1171290411,
      "version": 126,
      "versionNonce": 1064672101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788352325235,
      "link": null,
      "locked": false,
      "text": "∆Wih = α * Eh * sigmoid (Oh) * (1- sigmoid (Oh)) * OiT",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "∆Wih = α * Eh * sigmoid (Oh) * (1- sigmoid (Oh)) * OiT",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MDwhbYZghi_bMM4BQA2Yi",
      "type": "text",
      "x": 5115.813078840733,
      "y": 1512.0426675963968,
      "width": 751.6496198860267,
      "height": 286.53920169152144,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NBl4zNV_0fJPPt_bVEoxm",
      "index": "bFCt",
      "roundness": null,
      "seed": 976328875,
      "version": 115,
      "versionNonce": 1599530693,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788352325235,
      "link": null,
      "locked": false,
      "text": "Where:\n∆Wih = delta of the weights between input and the hidden layer\ni = input layer\nh = hidden layer\nα = learning rate\nEh = error rate hidden layer\nOh = output of hidden layer before the activation function\nsigmoid () = activation function\nsigmoid (Oh) * (1- sigmoid (Oh)) = derivative of activation function\nOiT = output of input layer after activation function transposed",
      "fontSize": 22.923136135321716,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Where:\n∆Wih = delta of the weights between input and the hidden layer\ni = input layer\nh = hidden layer\nα = learning rate\nEh = error rate hidden layer\nOh = output of hidden layer before the activation function\nsigmoid () = activation function\nsigmoid (Oh) * (1- sigmoid (Oh)) = derivative of activation function\nOiT = output of input layer after activation function transposed",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
